{
  "name": "univ-share",
  "private": true,
  "version": "1.0.0",
  "description": "Univ-Share — donner, échanger et partager le matériel du campus.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "check": "tsc -b --noEmit && eslint . && vitest run",
    "audit:ui": "node scripts/audit-ui.mjs",
    "seed": "convex run seed:ensure",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@vly-ai/integrations": "^0.6.14",
    "axios": "^1.13.2",
    "convex": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.10.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.65.0",
    "prettier": "3.7.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vitest": "^5.1.0"
  }
}
